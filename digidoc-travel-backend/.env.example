NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=digidoc_travel

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT - OWASP A02: rotate secrets in prod, 32+ chars
JWT_SECRET=digidoc-secret-key-change-in-production-32chars
JWT_REFRESH_SECRET=digidoc-refresh-secret-change-in-production-32chars
JWT_ISSUER=digidoc.travel
JWT_AUDIENCE=digidoc-frontend

# Encryption - OWASP A02: AES-256-GCM key (32 chars) - change in prod!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# CORS - OWASP A05: whitelist
CORS_ORIGIN=http://localhost:4200

# Kafka
KAFKA_BROKER=localhost:9092

# Security - OWASP A07
BCRYPT_ROUNDS=12
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_TIME=900000
